# Copy to .env (docker compose) or ~/.dastyar/.env. Never commit the real file.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Required when the server is reachable from the network (generate with: dastyar token)
DASTYAR_TOKEN=

# Optional
# HTTPS_PROXY=http://127.0.0.1:8080
# TAVILY_API_KEY=
# DASTYAR_ALLOWED_HOSTS=agent.example.com   # extra Host names when behind a proxy without a token
